<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <SolidColorBrush x:Key="PanelBackground" Color="#111418" />
    <SolidColorBrush x:Key="PanelSurface" Color="#1A2027" />
    <SolidColorBrush x:Key="PanelBorder" Color="#303944" />
    <SolidColorBrush x:Key="PanelAccent" Color="#CFB174" />
    <SolidColorBrush x:Key="PanelText" Color="#E6E9ED" />
    <SolidColorBrush x:Key="MutedText" Color="#A0ACBA" />
    <SolidColorBrush x:Key="PositiveBrush" Color="#7ACBA1" />
    <SolidColorBrush x:Key="NegativeBrush" Color="#EF9396" />
    <Thickness x:Key="PanelPadding">12</Thickness>
    <CornerRadius x:Key="ControlRadius">4</CornerRadius>
  </Styles.Resources>
  <Style Selector="Window.workspace">
    <Setter Property="Background" Value="{StaticResource PanelBackground}" /><Setter Property="Foreground" Value="{StaticResource PanelText}" />
    <Setter Property="FontFamily" Value="Segoe UI, Noto Sans, sans-serif" /><Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource PanelSurface}" /><Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
    <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" /><Setter Property="Padding" Value="{StaticResource PanelPadding}" />
  </Style>
  <Style Selector="TextBlock.title"><Setter Property="FontSize" Value="18" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.eyebrow"><Setter Property="Foreground" Value="{StaticResource PanelAccent}" /><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{StaticResource MutedText}" /><Setter Property="FontSize" Value="11" /></Style>
  <Style Selector="TextBlock.numeric"><Setter Property="TextAlignment" Value="Right" /><Setter Property="FontFeatures" Value="tnum" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
  <Style Selector="TextBlock.positive"><Setter Property="Foreground" Value="{StaticResource PositiveBrush}" /></Style>
  <Style Selector="TextBlock.negative"><Setter Property="Foreground" Value="{StaticResource NegativeBrush}" /></Style>
  <Style Selector="Button, TextBox, ComboBox"><Setter Property="MinHeight" Value="30" /><Setter Property="FontSize" Value="12" /><Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" /></Style>
  <Style Selector="Button"><Setter Property="Background" Value="#252E39" /><Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="10,5" /></Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#35424F" /></Style>
  <Style Selector="Button:pressed /template/ ContentPresenter"><Setter Property="Background" Value="#445362" /></Style>
  <Style Selector="Button:focus-visible"><Setter Property="BorderBrush" Value="{StaticResource PanelAccent}" /></Style>
  <Style Selector="Button:disabled"><Setter Property="Opacity" Value="0.45" /></Style>
  <Style Selector="Button.primary"><Setter Property="Background" Value="#CFB174" /><Setter Property="Foreground" Value="#171A1E" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#E4C992" /><Setter Property="Foreground" Value="#171A1E" /></Style>
  <Style Selector="TextBox, ComboBox"><Setter Property="Background" Value="#12171D" /><Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" /></Style>
  <Style Selector="TextBox:focus"><Setter Property="BorderBrush" Value="{StaticResource PanelAccent}" /></Style>
  <Style Selector="TableView"><Setter Property="Background" Value="#14191F" /></Style>
  <Style Selector="TableViewColumnHeader"><Setter Property="Background" Value="#222B35" /><Setter Property="Foreground" Value="{StaticResource MutedText}" /><Setter Property="FontSize" Value="11" /><Setter Property="Padding" Value="10,8" /></Style>
  <Style Selector="TableViewRow"><Setter Property="Height" Value="36" /><Setter Property="MinHeight" Value="36" /><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="#151B22" /></Style>
  <Style Selector="TableViewRow:nth-child(2n)"><Setter Property="Background" Value="#1A222B" /></Style>
  <Style Selector="TableViewRow:pointerover"><Setter Property="Background" Value="#2A3745" /></Style>
  <Style Selector="TableViewRow:selected"><Setter Property="Background" Value="#36483C" /></Style>
  <Style Selector="TableViewCell"><Setter Property="Padding" Value="10,6" /><Setter Property="BorderBrush" Value="#29323C" /><Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <Style Selector="TableViewCell TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>
  <Style Selector="ListBoxItem"><Setter Property="MinHeight" Value="36" /><Setter Property="Padding" Value="8,6" /></Style>
</Styles>
